{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/sapi-manifest.v2.schema.json",
  "schemaVersion": 2,
  "id": "gui",
  "name": "声明式界面运行时",
  "configKey": "gui",
  "enabledByDefault": true,
  "canDisable": false,
  "requires": [],
  "permissions": [
    "config:read:gui",
    "service:gui.registerFeature",
    "service:gui.unregisterFeature",
    "service:gui.listEntries",
    "service:gui.openScreen",
    "service:gui.confirm",
    "service:gui.showForm",
    "service:gui.catalog.demo",
    "service:gui.catalog.echo"
  ],
  "services": {
    "provides": [
      {
        "name": "gui.registerFeature",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.unregisterFeature",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.listEntries",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.openScreen",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.confirm",
        "input": { "type": "object" },
        "output": { "type": "boolean" }
      },
      {
        "name": "gui.showForm",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.catalog.demo",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "gui.catalog.echo",
        "input": { "type": "object" },
        "output": { "type": "object" }
      }
    ],
    "requires": []
  },
  "notes": "声明式页面运行时，附带 /c:catalog 控件目录供目视核对全部 JSON 声明。"
}
